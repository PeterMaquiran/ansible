# -----------------------------------------------------------------------------
# Ansible playground — practice lab (not production secrets)
# Copy is committed on purpose; rotate if you ever expose this host publicly.
# -----------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=ansible-playground

UBUNTU_VERSION=22.04

ANSIBLE_SSH_USER=ansible
ANSIBLE_SSH_PASSWORD=ansible

# Public key installed on web01 + web02 (must match private key below)
ANSIBLE_AUTHORIZED_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKSTrdkDTsKUbooxP3v1VWxzHCUM4SA05WLnU5nPrjql ansible-playground-control"

# From your Mac (ansible / ssh on host)
ANSIBLE_PRIVATE_KEY_HOST_PATH=./ssh/ansible_control_ed25519
WEB01_SSH_HOST=127.0.0.1
WEB01_SSH_PORT=2221
WEB02_SSH_HOST=127.0.0.1
WEB02_SSH_PORT=2222
WEB01_HTTP_PORT=8081
WEB02_HTTP_PORT=8082

# Inside the control container (docker compose --profile control)
ANSIBLE_PRIVATE_KEY_CONTAINER_PATH=/run/ansible/ssh_key

# Inventory / runtime identity (one controller, many nodes)
ANSIBLE_CONTROLLER_NAME=ansible-control
LAB_ENVIRONMENT=lab
APP_NAME=ansible-playground
APP_OWNER=ito

# Optional package versions for webserver role
NGINX_PACKAGE=nginx